# ChronoFlow .gitignore

# ========================
# Environment & Secrets
# ========================
.env
.env.*
*.pem
*.keystore
*.jks
.keys
XAXINAN.pem

# ========================
# Build Outputs
# ========================
target/
build/
*.jar
*.apk
*.aab
*.tar.gz

# ========================
# IDE
# ========================
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store

# ========================
# Backend
# ========================
backend/.mvn/wrapper/maven-wrapper.jar
backend/target/
start-prod.sh

# ========================
# Frontend (Flutter)
# ========================
frontend/.dart_tool/
frontend/.flutter-plugins-dependencies
frontend/.pub/
frontend/.pub-cache/
frontend/android/.gradle/
frontend/android/app/chronoflow.keystore
frontend/android/app/debug
frontend/android/app/libs/*.aar
frontend/android/app/profile
frontend/android/app/release
frontend/build/
frontend/coverage/
frontend/ios/Flutter/.last_build_id
frontend/ios/Pods/
frontend/ios/Runner/FaceVerifyPlugin.swift
frontend/local.properties
uploads/

# ========================
# Web (React)
# ========================
web/node_modules/

# ========================
# Misc
# ========================
db_backup/
release/
.git-rewrite/
