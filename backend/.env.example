# ChronoFlow 本地开发环境变量模板
# 复制为 .env 后填入实际值，IDEA Run Configuration → EnvFile 导入

# 数据库
DB_URL=jdbc:mysql://localhost:3306/chronoflow?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT（至少 32 字节）
JWT_SECRET=生成一个至少32字节的随机字符串

# 加密密钥（用于身份证号AES加密，至少32字符，请勿与JWT_SECRET相同）
CRYPTO_SECRET=生成一个与JWT_SECRET不同的32字节随机字符串

# AI（可选）
DASHSCOPE_API_KEY=

# 阿里云短信（可选）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 阿里云邮件（可选）
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=时纪流

# 阿里云内容审核（可选）
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# 阿里云金融级实人认证（可选）
ALIYUN_CLOUDAUTH_ACCESS_KEY_ID=
ALIYUN_CLOUDAUTH_ACCESS_KEY_SECRET=
ALIYUN_CLOUDAUTH_SCENE_ID=

# MinIO 对象存储（本地开发默认使用 minioadmin/minioadmin）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chronoflow
MINIO_BASE_URL=http://localhost:9000/chronoflow
